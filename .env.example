# Puerto en el que corre el servidor backend
PORT=5000

# URL de conexión para la base de datos PostgreSQL en Supabase.
DATABASE_URL=your_database_url_here
DIRECT_URL=your_direct_database_url_here

# Secreto y expiración para firma de JWT.
JWT_SECRET=supersecretkeyreplaceinproduction
JWT_EXPIRES_IN=24h

# Credenciales para el administrador por defecto usado en el seed.
ADMIN_EMAIL=admin@autorenova.com
ADMIN_PASSWORD=AdminPass123!

# Credenciales S3 compatibles de Supabase Storage para fotos de vehículos.
# En Supabase: Project Settings > Storage > S3 access keys.
SUPABASE_S3_ENDPOINT=https://yourproject.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=us-east-1
S3_BUCKET_NAME=autorenova-bucket
SUPABASE_STORAGE_PUBLIC_URL=https://yourproject.supabase.co/storage/v1/object/public/autorenova-bucket

# URL del frontend para CORS.
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1
